# Copy to .env.local for local work; on Vercel, add these under Project > Settings > Environment Variables.
# Public address of the CMS (its API serves the site's content and photos), e.g. https://cms.example.com
CMS_API_URL=http://localhost:4000
# Must match REVALIDATE_SECRET in the CMS .env: the CMS sends it when content changes, so pages refresh.
REVALIDATE_SECRET=change-me
# This website's own public address (canonical links, sitemap, schema), e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
